# FERAL backend environment — copy to `.env`:  cp .env.example .env
# Only DEPLOYER_PRIVATE_KEY and SUPABASE_SERVICE_KEY are secret; everything
# else is public testnet config. Never commit the real `.env`.

# ── Tempo testnet (Moderato, chain id 42431) ─────────────────────────────
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431
TEMPO_EXPLORER_URL=https://explore.testnet.tempo.xyz
TEMPO_FEE_PAYER_URL=                 # optional fee-payer endpoint

# ── Data / indexer ───────────────────────────────────────────────────────
TIDX_URL=                            # Tempo indexer endpoint (payment + invoice indexer)
SUPABASE_URL=                        # https://<project>.supabase.co
SUPABASE_SERVICE_KEY=                # service-role key — server-side only, never expose

# ── Server ───────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=                          # long random string (openssl rand -hex 32)
FRONTEND_URL=http://localhost:3000   # CORS origin for the dashboard

# ── Deployer / signer ────────────────────────────────────────────────────
# 0x + 64 hex. Owner of FeralPolicyEngine; signs policy syncs and engine.pay().
# Keep server-side only. NEVER commit the real key.
DEPLOYER_PRIVATE_KEY=

# ── Deployed contracts (Moderato) ────────────────────────────────────────
FERAL_REGISTRY_ADDRESS=0xe377Cb5aAB782315eF5bDa4ABA1be953a7156925
INVOICE_VAULT_ADDRESS=0xc6dFd5ad02d877582A4c81840Ab4E944c608021a
FERAL_POLICY_ENGINE_ADDRESS=0xDF445D3B191D7d0D0D31053890bEb1E712d96eCc
USDC_ADDRESS=0x20c0000000000000000000000000000000000000   # PathUSD (TIP-20, 6 decimals)

# ── TIP-1022 virtual addresses ───────────────────────────────────────────
VIRTUAL_MASTER_ID=fd8f153c           # registered masterId (registerVirtualMaster)

# Frontend vars (NEXT_PUBLIC_*) live in dashboard/.env.local — see
# dashboard/.env.example. The backend does not read them.
