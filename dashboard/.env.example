# FERAL Frontend Environment Variables
# Copy this file to .env.local:  cp .env.example .env.local
# (Next.js only reads NEXT_PUBLIC_* values that are present at dev/build start.)

# Backend API (Express server)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Silent demo session — the dashboard acquires its JWT via register/login
# with these credentials so it opens directly onto the seeded workspace.
# This is the public testnet demo account; treat it as shareable, not secret.
NEXT_PUBLIC_DEMO_EMAIL=demo@feral.app
NEXT_PUBLIC_DEMO_PASSWORD=feral-demo-1234

# Tempo testnet (Moderato)
NEXT_PUBLIC_TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
NEXT_PUBLIC_TEMPO_CHAIN_ID=42431
NEXT_PUBLIC_TEMPO_EXPLORER_URL=https://explore.testnet.tempo.xyz

# PathUSD TIP-20 token (6 decimals, from faucet.moderato.tempo.xyz)
NEXT_PUBLIC_USDC_ADDRESS=0x20c0000000000000000000000000000000000000

# Deployed contract addresses
NEXT_PUBLIC_FERAL_REGISTRY_ADDRESS=0xe377Cb5aAB782315eF5bDa4ABA1be953a7156925
NEXT_PUBLIC_INVOICE_VAULT_ADDRESS=0xc6dFd5ad02d877582A4c81840Ab4E944c608021a
